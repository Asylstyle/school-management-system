@startuml builder
!pragma layout smetana
title Builder - course construction
skinparam classAttributeIconSize 0
skinparam shadowing false

class Course {
  -code: String
  -title: String
  -teacherId: String
  -capacity: int
  -grading: GradingStrategy
  -semester: String
  -credits: int
  -prerequisites: List<String>
  -Course(b: Builder)
  +{static} builder(code, title): Builder
  +code(): String
  +title(): String
  +teacherId(): String
  +capacity(): int
  +grading(): GradingStrategy
  +semester(): String
  +credits(): int
  +prerequisites(): List<String>
}
class "Course.Builder" as Builder {
  -code: String
  -title: String
  -teacherId: String
  -capacity: int = 25
  -grading: GradingStrategy
  -semester: String = "Fall"
  -credits: int = 5
  -prerequisites: List<String>
  +teacher(id: String): Builder
  +capacity(value: int): Builder
  +grading(value: GradingStrategy): Builder
  +semester(value: String): Builder
  +credits(value: int): Builder
  +prerequisite(courseCode: String): Builder
  +build(): Course
}
interface GradingStrategy
class ConsoleApp
class DemoData

Builder ..> Course : creates
Course --> GradingStrategy
ConsoleApp ..> Builder
DemoData ..> Builder
@enduml
