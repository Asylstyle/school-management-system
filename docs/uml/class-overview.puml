@startuml SchoolDeskOverview

skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 6
skinparam nodesep 40
skinparam ranksep 50
hide empty members

skinparam title {
  FontSize 18
  FontStyle bold
  FontColor #1E293B
  Padding 15
}

skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  BorderThickness 1.4
  HeaderBackgroundColor #E2E8F0
  FontColor #0F172A
  FontName "Segoe UI", Arial, sans-serif
  FontSize 12
  AttributeFontSize 11
  AttributeIconSize 0
}

skinparam interface {
  BackgroundColor #FEF3C7
  BorderColor #D97706
  HeaderBackgroundColor #FDE68A
}

skinparam abstract {
  BackgroundColor #F3E8FF
  BorderColor #7E22CE
  HeaderBackgroundColor #E9D5FF
}

skinparam package {
  BorderColor #CBD5E1
  FontColor #334155
  FontStyle bold
  FontSize 13
  RoundCorner 8
}

skinparam arrow {
  Color #475569
  FontColor #475569
  FontSize 10
  Thickness 1.3
}

title SchoolDesk - System Architecture (Class Overview)

package "Application & Facade" #F8FAFC {
  class ConsoleApp {
    - access : Access
    + {static} main(args : String[])
    ~ run()
  }

  class SchoolFacade <<Facade>> {
    + register(access, role, id, name) : Person
    + addCourse(access, course)
    + enroll(access, studentId, courseCode)
    + recordGrade(access, studentId, courseCode, assessment)
    + completeCourse(access, studentId, courseCode) : GradeResult
    + issueReport(access, studentId) : StudentReport
    + reportDeniedAccess(message)
  }
}

package "Access Control (Decorator)" #F0FDF4 {
  interface Access
  class ReadOnlyAccess
  abstract class AccessDecorator
  class RegistrarAccess
  class GradingAccess
  class AuditedAccess
  class AccessModes <<Factory>>
}

package "People Management (Factory Method)" #EFF6FF {
  class PersonRegistry
  abstract class PersonCreator
  class StudentCreator
  class TeacherCreator
  abstract class Person
  class Student
  class Teacher
}

package "Event System (Observer)" #FFF7ED {
  class EventBus
  interface SchoolListener
  class ActivityLog
  class StudentNotifier
  class TeacherNotifier
  class Inbox
}

package "Academics & Grading (Builder / Strategy)" #FDF4FF {
  class CourseCatalog
  class EnrollmentService
  class GradingService
  class Course
  class "Course.Builder" as CourseBuilder
  class Enrollment
  class Assessment
  interface GradingStrategy
  class WeightedGrading
  class PassFailGrading
  class GradingPolicies
}

ConsoleApp --> SchoolFacade
ConsoleApp --> Access
ConsoleApp ..> AuditedAccess
SchoolFacade ..> Access
SchoolFacade *-- PersonRegistry
SchoolFacade *-- CourseCatalog
SchoolFacade *-- EnrollmentService
SchoolFacade *-- GradingService
SchoolFacade --> EventBus

Access <|.. ReadOnlyAccess
Access <|.. AccessDecorator
AccessDecorator o-- Access
AccessDecorator <|-- RegistrarAccess
AccessDecorator <|-- GradingAccess
AccessDecorator <|-- AuditedAccess
AccessModes ..> Access

PersonRegistry o-- PersonCreator
PersonRegistry o-- Person
PersonCreator <|-- StudentCreator
PersonCreator <|-- TeacherCreator
Person <|-- Student
Person <|-- Teacher
PersonCreator ..> Person

EventBus o-- SchoolListener
SchoolListener <|.. ActivityLog
SchoolListener <|.. StudentNotifier
SchoolListener <|.. TeacherNotifier
StudentNotifier --> Inbox
TeacherNotifier --> Inbox

CourseCatalog o-- Course
EnrollmentService o-- Enrollment
Enrollment *-- Assessment
GradingService ..> Enrollment
GradingService ..> Course
CourseBuilder ..> Course
Course --> GradingStrategy
GradingStrategy <|.. WeightedGrading
GradingStrategy <|.. PassFailGrading
GradingPolicies o-- GradingStrategy

@enduml
