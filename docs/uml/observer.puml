@startuml observer
!pragma layout smetana
title Observer - school events
skinparam classAttributeIconSize 0
skinparam shadowing false

class EventBus {
  -listeners: List<SchoolListener>
  +subscribe(l: SchoolListener)
  +unsubscribe(l: SchoolListener)
  +publish(e: SchoolEvent)
}
interface SchoolListener {
  +onEvent(e: SchoolEvent)
}
class ActivityLog {
  -events: List<SchoolEvent>
  +onEvent(e: SchoolEvent)
  +events(): List<SchoolEvent>
}
class StudentNotifier {
  +onEvent(e: SchoolEvent)
}
class TeacherNotifier {
  +onEvent(e: SchoolEvent)
}
class Inbox {
  -messages: Map<String, List<String>>
  +deliver(personId: String, text: String)
  +of(personId: String): List<String>
}
class SchoolEvent {
  +type(): EventType
  +message(): String
  +at(): Instant
  +studentId(): String
  +teacherId(): String
}
enum EventType {
  PERSON_REGISTERED
  COURSE_CREATED
  STUDENT_ENROLLED
  GRADE_RECORDED
  COURSE_COMPLETED
  REPORT_READY
  ACCESS_DENIED
}
class SchoolFacade {
  -emit(type, message, studentId, teacherId)
}

EventBus o-- "0..*" SchoolListener
SchoolListener <|.. ActivityLog
SchoolListener <|.. StudentNotifier
SchoolListener <|.. TeacherNotifier
StudentNotifier --> Inbox
TeacherNotifier --> Inbox
EventBus ..> SchoolEvent
SchoolEvent --> EventType
SchoolFacade --> EventBus : publishes
note bottom of SchoolEvent
  studentId and teacherId are null
  when the event concerns no such person
end note
note right of StudentNotifier
  GRADE_RECORDED, COURSE_COMPLETED,
  REPORT_READY
end note
note right of TeacherNotifier
  STUDENT_ENROLLED
end note
@enduml
