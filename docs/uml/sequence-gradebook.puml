@startuml sequence-gradebook
title Showing the gradebook
skinparam shadowing false
autonumber

actor User
participant ConsoleApp
participant SchoolFacade
participant CourseCatalog
participant GradingService
participant Course
participant "grading: GradingStrategy" as Strategy
participant GradeMath

User -> ConsoleApp : 7 Gradebook
ConsoleApp -> SchoolFacade : enrollments(access)
loop for each enrollment
  ConsoleApp -> SchoolFacade : result(access, enrollment)
  SchoolFacade -> CourseCatalog : find(enrollment.courseCode())
  SchoolFacade -> GradingService : result(enrollment, course)
  GradingService -> Course : grading()
  Course --> GradingService : strategy of this course
  GradingService -> Strategy : calculate(assessments)
  Strategy -> GradeMath : average(assessments)
  GradeMath --> Strategy : rounded score
  Strategy --> GradingService : GradeResult(score, label)
  GradingService --> SchoolFacade : Optional<GradeResult>
  SchoolFacade --> ConsoleApp : Optional<GradeResult>
end
ConsoleApp --> User : student, course, score / label
@enduml
