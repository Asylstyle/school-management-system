@startuml facade
!pragma layout smetana
title Facade - SchoolFacade
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

class ConsoleApp
class CsvExport
class SchoolFacade {
  +register(access, role, id, name): Person
  +addCourse(access, course)
  +enroll(access, studentId, courseCode)
  +recordGrade(access, studentId, courseCode, assessment)
  +issueReport(access, studentId): StudentReport
  +people(access): List<Person>
  +courses(access): List<Course>
  +enrollments(access): List<Enrollment>
  +result(access, enrollment): Optional<GradeResult>
}
class PersonRegistry {
  +register(role, id, name): Person
  +student(id): Person
  +teacher(id): Person
}
class EnrollmentService {
  +addCourse(course)
  +enroll(studentId, course): Enrollment
  +find(studentId, courseCode): Enrollment
}
class GradingService {
  +record(enrollment, assessment)
  +result(enrollment, course): Optional<GradeResult>
  +passed(enrollment, course): boolean
}
class EventBus {
  +publish(event)
}
interface Access {
  +require(permission)
}

ConsoleApp --> SchoolFacade
CsvExport ..> SchoolFacade
SchoolFacade *-- PersonRegistry
SchoolFacade *-- EnrollmentService
SchoolFacade *-- GradingService
SchoolFacade --> EventBus
SchoolFacade ..> Access
@enduml
