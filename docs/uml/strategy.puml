@startuml strategy
!pragma layout smetana
title Strategy - grading policies
skinparam classAttributeIconSize 0
skinparam shadowing false

interface GradingStrategy {
  +calculate(items: List<Assessment>): Optional<GradeResult>
  +name(): String
}
class WeightedGrading {
  +calculate(items): Optional<GradeResult>
  +name(): String
}
class PassFailGrading {
  +calculate(items): Optional<GradeResult>
  +name(): String
}
class GradeMath {
  ~{static} average(items: List<Assessment>): double
  ~{static} round(score: double): double
}
class GradeResult {
  +score(): double
  +label(): String
  +passed(): boolean
  +display(): String
}
class GradingPolicies {
  -{static} POLICIES: Map<String, GradingStrategy>
  +{static} byName(name: String): GradingStrategy
  +{static} names(): String
}
class Course {
  +grading(): GradingStrategy
}
class GradingService {
  +result(enrollment, course): Optional<GradeResult>
}

GradingStrategy <|.. WeightedGrading
GradingStrategy <|.. PassFailGrading
WeightedGrading ..> GradeMath
PassFailGrading ..> GradeMath
GradingStrategy ..> GradeResult
GradingPolicies o-- "1..*" GradingStrategy
Course --> GradingStrategy
GradingService ..> Course
@enduml
