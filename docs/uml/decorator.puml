@startuml DecoratorStrictUML

skinparam linetype ortho
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam nodesep 65
skinparam ranksep 65
skinparam classAttributeIconSize 0
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  BorderThickness 1
}

skinparam arrow {
  Color #000000
  Thickness 1
}

title Decorator - Access Control

interface Access {
  + allows(p : Permission) : boolean
  + label() : String
  + require(p : Permission) : void
}

class ReadOnlyAccess {
  + allows(p : Permission) : boolean
  + label() : String
}

abstract class AccessDecorator {
  # wrapped : Access
  # AccessDecorator(wrapped : Access)
  + allows(p : Permission) : boolean
  + label() : String
}

class RegistrarAccess {
  + RegistrarAccess(wrapped : Access)
  + allows(p : Permission) : boolean
  + label() : String
}

class GradingAccess {
  + GradingAccess(wrapped : Access)
  + allows(p : Permission) : boolean
  + label() : String
}

class AuditedAccess {
  - auditLog : Consumer<String>
  + AuditedAccess(wrapped : Access, auditLog : Consumer<String>)
  + allows(p : Permission) : boolean
}

enum Permission {
  VIEW
  MANAGE_PEOPLE
  MANAGE_COURSES
  ENROLL
  RECORD_GRADES
  ISSUE_REPORTS
}

class AccessModes {
  + {static} viewer() : Access
  + {static} registrar() : Access
  + {static} grading() : Access
  + {static} admin() : Access
  + {static} byName(name : String) : Access
  + {static} names() : String
}

class AccessDeniedException <<exception>> {
  + AccessDeniedException(permission : Permission)
}

Access <|.. ReadOnlyAccess
Access <|.. AccessDecorator
AccessDecorator o--> "1" Access : #wrapped
AccessDecorator <|-- RegistrarAccess
AccessDecorator <|-- GradingAccess
AccessDecorator <|-- AuditedAccess

Access ..> Permission
Access ..> AccessDeniedException
AccessModes ..> Access : <<create>>

@enduml
